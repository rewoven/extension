        "*://*.puma.com/*",
        "*://*.ralphlauren.com/*",
        "*://*.reebok.com/*",
        "*://*.rei.com/*",
        "*://*.riverisland.com/*",
        "*://*.romwe.com/*",
        "*://*.shein.com/*",
        "*://*.stellamccartney.com/*",
        "*://*.stories.com/*",
        "*://*.stradivarius.com/*",
        "*://*.superdry.com/*",
        "*://*.target.com/*",
        "*://*.temu.com/*",
        "*://*.tentree.com/*",
        "*://*.thenorthface.com/*",
        "*://*.thereformation.com/*",
        "*://*.thoughtclothing.com/*",
        "*://*.tommy.com/*",
