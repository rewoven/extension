        "*://*.zaful.com/*",
        "*://*.zara.com/*"
      ],
      "js": [
        "content/index.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.rewovenapp.com/*"
  ]
}
